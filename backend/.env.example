# BASIRAH — backend environment variables (sample)
# Copy to `.env` and adjust. Never commit real secrets — this file contains
# only public endpoints and deployment configuration.

# --- Deployment environment ---
# development | production
BASIRAH_ENV=development

# --- CORS ---
# Comma-separated list of allowed origins (CORS_ALLOWED_ORIGINS compatible).
# Wildcard (*) is never accepted. Add your production frontend origin:
#   https://ish3-is.github.io
BASIRAH_CORS_ORIGINS=

# --- Model directory ---
# Override the default models/ directory (useful when serving models from a
# mounted volume or a model-serving host). Empty = use <repo>/backend/models.
MODEL_DIR=

# --- Tesseract ---
# Path to the tesseract executable. Linux: leave empty and rely on PATH
# (ensure `tesseract` is installed and on PATH).
TESSERACT_BIN=

# --- Python ---
# Python 3.12+ recommended.
