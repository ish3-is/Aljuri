# BASIRAH frontend environment
# Copy to `.env.local` and adjust. Never commit real secrets —
# Phase 2 has none, and this file contains only public endpoints.

# Delivery mode for this build.
#   local    — call the real backend; preserve full analysis.
#   showcase — static frontend; no live API calls; demo/sample data.
# Builds are fixed at build time by Vite (define) and cannot be toggled
# at runtime. The GitHub Pages workflow sets VITE_APP_MODE=showcase.
#
# Local development / local production builds:
#   VITE_APP_MODE=local
#
# GitHub Pages build (set by .github/workflows/deploy-pages.yml):
#   VITE_APP_MODE=showcase
#
# VITE_APP_MODE is ONLY this build's delivery mode. Do NOT infer mode
# from hostname alone: a static GitHub Pages page must never decide to
# call localhost on its own.
VITE_APP_MODE=local

# Base URL of the BASIRAH backend (Phase 2 URL Intelligence Engine).
#
# Leave EMPTY to use the same origin, which is the right setting when a
# reverse proxy or a same-domain deployment fronts the API. Set it during
# local development so the Vite dev server can reach the backend.
#
# Development value:
VITE_API_BASE_URL=http://localhost:8000

# Production example (same-origin, no value needed):
# VITE_API_BASE_URL=
